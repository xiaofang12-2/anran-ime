# XcodeGen 生成物（云端 CI 会自己生成，不入库）
AnRanIME.xcodeproj/
*.xcworkspace/
xcuserdata/
*.xcuserstate
DerivedData/
build/

# 打出来的包
Payload/
*.ipa

# 本地出包暂存
_out/

# 词库构建的临时备份与 Python 缓存
Support/dict/*.bak
__pycache__/
*.pyc

# 本地调试脚本与构建日志
tools/_*.py
tools/*.log
tools/build_log.txt

# Rime 方案数据（CI 拉鼠须管 SharedSupport 填进来，几十 MB，不入库）
Support/rime/*
!Support/rime/.gitkeep

# 便携工具
.tools/

# 系统垃圾
.DS_Store
Thumbs.db
